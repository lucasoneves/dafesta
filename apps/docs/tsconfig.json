{
  "extends": "@dafesta/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@dafesta/ui": ["../../packages/ui/src"],
      "@dafesta/ui/*": ["../../packages/ui/src/*"],
      "@dafesta/types": ["../../packages/types/src"],
      "@dafesta/types/*": ["../../packages/types/src/*"],
      "@dafesta/utils": ["../../packages/utils/src"],
      "@dafesta/utils/*": ["../../packages/utils/src/*"],
      "@dafesta/database": ["../../packages/database/src"],
      "@dafesta/database/*": ["../../packages/database/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
